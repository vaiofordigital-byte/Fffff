generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Locale {
  AR
  EN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  SUPPORT_AGENT
  CONTENT_EDITOR
  PROMPT_EDITOR
  ADMINISTRATOR
  SUPER_ADMIN
}

enum ProductType {
  PROMPT
  BUNDLE
  WORKFLOW
  CREDIT_PACK
  SUBSCRIPTION
}

enum ProductStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LicenseType {
  PERSONAL
  PROFESSIONAL
  COMMERCIAL
  AGENCY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum CreditTransactionType {
  SUBSCRIPTION_ALLOCATION
  PURCHASE
  USAGE
  REFUND
  ADMIN_ADJUSTMENT
  PROMOTION
}

enum EntitlementSource {
  PURCHASE
  SUBSCRIPTION
  BUNDLE
  ADMIN
}

enum GenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  MODERATED
}

enum ModerationDecision {
  ALLOW
  REVIEW
  BLOCK
}

enum CollectionItemType {
  PROMPT
  WORKFLOW
  PROJECT
  NOTE
}

enum NotificationType {
  PURCHASE
  PROMPT_UPDATE
  CREDIT
  SUBSCRIPTION
  TASK
  REPORT
  RECOMMENDATION
  SECURITY
  SYSTEM
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrganizationRole {
  OWNER
  MANAGER
  EMPLOYEE
  VIEWER
}

enum AiEmployeeType {
  MARKETING_MANAGER
  CUSTOMER_SERVICE_MANAGER
  SALES_ASSISTANT
  CONTENT_CREATOR
  ECOMMERCE_MANAGER
  BUSINESS_ANALYST
  INDUSTRY_SPECIALIST
}

enum AiEmployeeActivationStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum KnowledgeKind {
  COMPANY_PROFILE
  PRODUCT
  SERVICE
  POLICY
  CUSTOMER
  FAQ
  BRAND_VOICE
  PROCEDURE
  DOCUMENT
}

enum KnowledgeSource {
  MANUAL
  PDF
  TEXT
  DOCUMENT
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum BusinessTaskStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  MODERATED
}

enum RecommendationStatus {
  NEW
  DISMISSED
  ACTED
}

enum BusinessReportType {
  WEEKLY
  BUSINESS
  MARKETING
  CUSTOMER_SERVICE
}

enum BusinessReportStatus {
  GENERATING
  READY
  FAILED
}

enum BusinessProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique @db.VarChar(191)
  passwordHash               String?                  @db.VarChar(255)
  status                     UserStatus               @default(PENDING)
  role                       UserRole                 @default(USER)
  preferredLocale            Locale                   @default(AR)
  emailVerifiedAt            DateTime?
  mfaEnabled                 Boolean                  @default(false)
  mfaSecretCiphertext        String?                  @db.Text
  lastLoginAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  deletedAt                  DateTime?
  profile                    Profile?
  sessions                   Session[]
  emailTokens                EmailVerificationToken[]
  resetTokens                PasswordResetToken[]
  orders                     Order[]
  entitlements               Entitlement[]
  subscriptions              Subscription[]
  creditAccount              CreditAccount?
  projects                   Project[]
  contexts                   Context[]
  generatedPrompts           GeneratedPrompt[]
  promptHistories            PromptHistory[]
  favorites                  Favorite[]
  collections                Collection[]
  reviews                    Review[]
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  workflowRuns               WorkflowRun[]
  searchEvents               SearchEvent[]
  analyticsEvents            AnalyticsEvent[]
  moderationEvents           ModerationEvent[]
  couponRedemptions          CouponRedemption[]
  auditActions               AuditLog[]               @relation("AuditActor")
  createdPromptVersions      PromptVersion[]          @relation("PromptVersionCreator")
  organizationMemberships    OrganizationMember[]
  activatedAiEmployees       OrganizationAiEmployee[] @relation("EmployeeActivator")
  uploadedKnowledgeDocuments KnowledgeDocument[]      @relation("DocumentUploader")
  createdKnowledgeEntries    KnowledgeEntry[]         @relation("KnowledgeCreator")
  businessTasks              BusinessTask[]
  aiUsageEvents              AiUsageEvent[]
  subscriptionCheckouts      SubscriptionCheckout[]

  @@index([status, createdAt])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String?  @db.VarChar(120)
  company        String?  @db.VarChar(160)
  industry       String?  @db.VarChar(120)
  primaryUse     String?  @db.VarChar(160)
  experience     String?  @db.VarChar(80)
  country        String?  @db.VarChar(2)
  avatarUrl      String?  @db.VarChar(500)
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique @db.VarChar(191)
  name                  String                   @db.VarChar(191)
  businessType          String?                  @db.VarChar(120)
  industry              String?                  @db.VarChar(120)
  country               String?                  @db.VarChar(2)
  goals                 Json?
  settings              Json?
  status                OrganizationStatus       @default(ACTIVE)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?
  members               OrganizationMember[]
  aiEmployees           OrganizationAiEmployee[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeEntries      KnowledgeEntry[]
  contexts              Context[]
  projects              Project[]
  businessTasks         BusinessTask[]
  aiUsageEvents         AiUsageEvent[]
  recommendations       BusinessRecommendation[]
  scoreSnapshots        BusinessScoreSnapshot[]
  reports               BusinessReport[]
  subscriptions         Subscription[]
  subscriptionCheckouts SubscriptionCheckout[]
  workflowRuns          WorkflowRun[]

  @@index([status, createdAt])
  @@index([industry, status])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  permissions    Json?
  active         Boolean          @default(true)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, role, active])
}

model AiEmployee {
  id                 String                    @id @default(cuid())
  slug               String                    @unique @db.VarChar(191)
  type               AiEmployeeType
  nameAr             String                    @db.VarChar(191)
  nameEn             String                    @db.VarChar(191)
  purposeAr          String                    @db.VarChar(500)
  purposeEn          String                    @db.VarChar(500)
  descriptionAr      String                    @db.Text
  descriptionEn      String                    @db.Text
  capabilities       Json
  actions            Json
  requiredKnowledge  Json
  systemInstructions String                    @db.LongText
  defaultCreditCost  Int                       @default(1)
  active             Boolean                   @default(true)
  sortOrder          Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  activations        OrganizationAiEmployee[]
  tasks              BusinessTask[]
  usageEvents        AiUsageEvent[]
  packageItems       IndustryPackageEmployee[]

  @@index([active, sortOrder])
  @@index([type, active])
}

model OrganizationAiEmployee {
  id             String                     @id @default(cuid())
  organizationId String
  aiEmployeeId   String
  activatedById  String
  status         AiEmployeeActivationStatus @default(ACTIVE)
  configuration  Json?
  usageLimit     Int?
  usageCount     Int                        @default(0)
  activatedAt    DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiEmployee     AiEmployee                 @relation(fields: [aiEmployeeId], references: [id], onDelete: Restrict)
  activatedBy    User                       @relation("EmployeeActivator", fields: [activatedById], references: [id], onDelete: Restrict)
  tasks          BusinessTask[]

  @@unique([organizationId, aiEmployeeId])
  @@index([organizationId, status])
}

model KnowledgeDocument {
  id             String                   @id @default(cuid())
  organizationId String
  uploadedById   String
  filename       String                   @db.VarChar(255)
  mimeType       String                   @db.VarChar(120)
  sizeBytes      Int
  checksum       String                   @db.Char(64)
  source         KnowledgeSource
  status         DocumentProcessingStatus @default(PENDING)
  extractedText  String?                  @db.LongText
  failureCode    String?                  @db.VarChar(120)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User                     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  entries        KnowledgeEntry[]

  @@unique([organizationId, checksum])
  @@index([organizationId, status, createdAt])
}

model KnowledgeEntry {
  id                String             @id @default(cuid())
  organizationId    String
  documentId        String?
  createdById       String
  kind              KnowledgeKind
  source            KnowledgeSource
  titleAr           String             @db.VarChar(191)
  titleEn           String             @db.VarChar(191)
  content           String             @db.LongText
  approved          Boolean            @default(true)
  privateMode       Boolean            @default(false)
  vectorReference   String?            @db.VarChar(500)
  embeddingMetadata Json?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document          KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("KnowledgeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, kind, approved])
  @@index([documentId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique @db.Char(64)
  ipHash        String?   @db.Char(64)
  userAgent     String?   @db.VarChar(500)
  mfaVerifiedAt DateTime?
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Category {
  id               String     @id @default(cuid())
  parentId         String?
  slug             String     @unique @db.VarChar(191)
  nameAr           String     @db.VarChar(160)
  nameEn           String     @db.VarChar(160)
  descriptionAr    String?    @db.Text
  descriptionEn    String?    @db.Text
  icon             String?    @db.VarChar(80)
  sortOrder        Int        @default(0)
  active           Boolean    @default(true)
  seoTitleAr       String?    @db.VarChar(191)
  seoTitleEn       String?    @db.VarChar(191)
  seoDescriptionAr String?    @db.VarChar(320)
  seoDescriptionEn String?    @db.VarChar(320)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")
  products         Product[]

  @@index([parentId, active, sortOrder])
}

model Tag {
  id        String        @id @default(cuid())
  slug      String        @unique @db.VarChar(191)
  nameAr    String        @db.VarChar(120)
  nameEn    String        @db.VarChar(120)
  products  ProductTag[]
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
}

model Product {
  id                   String              @id @default(cuid())
  categoryId           String?
  type                 ProductType         @default(PROMPT)
  status               ProductStatus       @default(DRAFT)
  slug                 String              @unique @db.VarChar(191)
  titleAr              String              @db.VarChar(191)
  titleEn              String              @db.VarChar(191)
  shortDescriptionAr   String              @db.VarChar(500)
  shortDescriptionEn   String              @db.VarChar(500)
  descriptionAr        String              @db.LongText
  descriptionEn        String              @db.LongText
  previewAr            String?             @db.LongText
  previewEn            String?             @db.LongText
  industry             String?             @db.VarChar(120)
  difficulty           DifficultyLevel     @default(INTERMEDIATE)
  price                Decimal             @default(0) @db.Decimal(12, 2)
  salePrice            Decimal?            @db.Decimal(12, 2)
  currency             String              @default("SAR") @db.Char(3)
  subscriptionEligible Boolean             @default(false)
  licenseType          LicenseType         @default(PERSONAL)
  featured             Boolean             @default(false)
  popularityScore      Int                 @default(0)
  purchaseCount        Int                 @default(0)
  ratingAverage        Decimal             @default(0) @db.Decimal(3, 2)
  ratingCount          Int                 @default(0)
  seoTitleAr           String?             @db.VarChar(191)
  seoTitleEn           String?             @db.VarChar(191)
  seoDescriptionAr     String?             @db.VarChar(320)
  seoDescriptionEn     String?             @db.VarChar(320)
  structuredData       Json?
  publishedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  category             Category?           @relation(fields: [categoryId], references: [id])
  prompt               Prompt?
  tags                 ProductTag[]
  orderItems           OrderItem[]
  entitlements         Entitlement[]
  reviews              Review[]
  favorites            Favorite[]
  bundleItems          ProductBundleItem[] @relation("Bundle")
  includedInBundles    ProductBundleItem[] @relation("BundleComponent")

  @@index([status, type, publishedAt])
  @@index([categoryId, status])
  @@index([featured, status])
  @@index([industry, status])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductBundleItem {
  bundleId  String
  productId String
  sortOrder Int     @default(0)
  bundle    Product @relation("Bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation("BundleComponent", fields: [productId], references: [id], onDelete: Restrict)

  @@id([bundleId, productId])
  @@index([productId])
}

model Prompt {
  id              String           @id @default(cuid())
  productId       String           @unique
  compatibility   Json
  languages       Json
  instructionsAr  String?          @db.LongText
  instructionsEn  String?          @db.LongText
  expectedOutputs Json?
  scoreWeights    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions        PromptVersion[]
  variables       PromptVariable[]
  histories       PromptHistory[]
  workflowSteps   WorkflowStep[]
}

model PromptVersion {
  id             String        @id @default(cuid())
  promptId       String
  createdById    String?
  version        String        @db.VarChar(24)
  premiumContent String        @db.LongText
  previewContent String?       @db.LongText
  changelogAr    String?       @db.Text
  changelogEn    String?       @db.Text
  structure      Json?
  qualityScore   Int?
  isCurrent      Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  prompt         Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("PromptVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entitlements   Entitlement[]

  @@unique([promptId, version])
  @@index([promptId, isCurrent])
}

model PromptVariable {
  id            String  @id @default(cuid())
  promptId      String
  key           String  @db.VarChar(80)
  labelAr       String  @db.VarChar(160)
  labelEn       String  @db.VarChar(160)
  descriptionAr String? @db.VarChar(500)
  descriptionEn String? @db.VarChar(500)
  inputType     String  @default("text") @db.VarChar(40)
  required      Boolean @default(true)
  defaultValue  String? @db.Text
  options       Json?
  sortOrder     Int     @default(0)
  prompt        Prompt  @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, key])
  @@index([promptId, sortOrder])
}

model Plan {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique @db.VarChar(80)
  nameAr                String                 @db.VarChar(120)
  nameEn                String                 @db.VarChar(120)
  descriptionAr         String?                @db.Text
  descriptionEn         String?                @db.Text
  monthlyPrice          Decimal                @db.Decimal(12, 2)
  yearlyPrice           Decimal                @db.Decimal(12, 2)
  currency              String                 @default("SAR") @db.Char(3)
  monthlyCredits        Int                    @default(0)
  limits                Json
  features              Json
  active                Boolean                @default(true)
  sortOrder             Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  subscriptions         Subscription[]
  subscriptionCheckouts SubscriptionCheckout[]

  @@index([active, sortOrder])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  organizationId         String?
  planId                 String
  provider               String?            @db.VarChar(80)
  providerSubscriptionId String?            @unique @db.VarChar(191)
  status                 SubscriptionStatus @default(TRIALING)
  interval               BillingInterval
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization           Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlements           Entitlement[]

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([status, currentPeriodEnd])
}

model SubscriptionCheckout {
  id                     String          @id @default(cuid())
  userId                 String
  organizationId         String
  planId                 String
  interval               BillingInterval
  provider               String          @db.VarChar(80)
  providerCheckoutId     String?         @unique @db.VarChar(191)
  providerSubscriptionId String?         @db.VarChar(191)
  checkoutUrl            String?         @db.VarChar(500)
  idempotencyKey         String          @unique @db.VarChar(191)
  status                 PaymentStatus   @default(PENDING)
  amount                 Decimal         @db.Decimal(12, 2)
  currency               String          @db.Char(3)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([planId, status])
}

model Order {
  id                String             @id @default(cuid())
  userId            String
  number            String             @unique @db.VarChar(40)
  idempotencyKey    String             @unique @db.VarChar(191)
  status            OrderStatus        @default(PENDING)
  currency          String             @db.Char(3)
  subtotal          Decimal            @db.Decimal(12, 2)
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  tax               Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  couponCode        String?            @db.VarChar(80)
  billingDetails    Json?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  entitlements      Entitlement[]
  couponRedemptions CouponRedemption[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  productId     String
  titleSnapshot String       @db.VarChar(191)
  unitPrice     Decimal      @db.Decimal(12, 2)
  quantity      Int          @default(1)
  tax           Decimal      @default(0) @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  licenseType   LicenseType
  metadata      Json?
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  entitlement   Entitlement?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  provider          String         @db.VarChar(80)
  providerPaymentId String?        @unique @db.VarChar(191)
  idempotencyKey    String         @unique @db.VarChar(191)
  status            PaymentStatus  @default(PENDING)
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @db.Char(3)
  failureCode       String?        @db.VarChar(120)
  failureMessage    String?        @db.VarChar(500)
  refundedAmount    Decimal        @default(0) @db.Decimal(12, 2)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]

  @@index([orderId, status])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  provider        String    @db.VarChar(80)
  providerEventId String    @db.VarChar(191)
  type            String    @db.VarChar(120)
  payloadHash     String    @db.Char(64)
  processedAt     DateTime?
  failedAt        DateTime?
  errorCode       String?   @db.VarChar(120)
  createdAt       DateTime  @default(now())
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([processedAt, createdAt])
}

model Entitlement {
  id              String            @id @default(cuid())
  userId          String
  productId       String
  orderId         String?
  orderItemId     String?           @unique
  subscriptionId  String?
  promptVersionId String?
  source          EntitlementSource
  licenseType     LicenseType
  startsAt        DateTime          @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem       OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  subscription    Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  promptVersion   PromptVersion?    @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

