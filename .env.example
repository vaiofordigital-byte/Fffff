# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=PROMPTX
SESSION_COOKIE_NAME=promptx_session
SESSION_TTL_DAYS=30
SECURITY_HASH_PEPPER=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# MySQL 8 / MariaDB
DATABASE_URL=mysql://promptx:change-me@127.0.0.1:3306/promptx
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=promptx
DATABASE_PASSWORD=change-me
DATABASE_NAME=promptx
DATABASE_CONNECTION_LIMIT=10

# Optional one-time administrator bootstrap used by `npm run db:seed`
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# AI providers (disabled unless all required values are configured)
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_API_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Payment adapter (none keeps checkout disabled)
PAYMENT_PROVIDER=none
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PROMPTX <no-reply@example.com>

# Optional error reporting; no private prompt content is sent
OBSERVABILITY_ENDPOINT=
OBSERVABILITY_TOKEN=
